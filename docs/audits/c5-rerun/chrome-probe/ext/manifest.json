{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "C5 Origin Probe",
  "version": "1.0",
  "description": "Audit probe: extension service worker WebSocket Origin header.",
  "permissions": [],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_title": "C5 Origin Probe" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*" }
}
