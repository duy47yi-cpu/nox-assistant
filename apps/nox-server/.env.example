# Имена переменных сервера Nox. Значения здесь не хранятся: файл с ними — .env, его не выкладывают.
# Запуск: скопировать нужные строки в окружение или в .env рядом с сервером.

# Адрес сервера
PORT=
HOST=

# База и тарифы
NOX_DB=
NOX_PLANS_FILE=
NOX_MODELS_FILE=

# Ключи провайдеров моделей (только на сервере)
NOX_FAST_KEY=
NOX_SMART_KEY=

# Служебный доступ и защита
NOX_ADMIN_KEY=
NOX_TRUST_PROXY=
NOX_GLOBAL_DAILY_USD=
NOX_SESSION_TTL_DAYS=
NOX_UPSTREAM_TIMEOUT_MS=
